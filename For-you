<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For You, My Love 💜</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&family=Sacramento&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #2a1b3d 0%, #150b24 100%);
            --card-bg: rgba(45, 30, 68, 0.75);
            --accent-purple: #b070f0;
            --accent-pink: #ff8fab;
            --light-purple: #e2cbf7;
            --text-main: #fff5f8;
            --text-muted: #d4c5e2;
        }

        body {
            margin: 0;
            padding: 20px 0;
            font-family: 'Poppins', sans-serif;
            background: var(--bg-gradient);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
            box-sizing: border-box;
        }

        .bg-shapes {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: -1;
            pointer-events: none;
        }

        .bg-shapes div {
            position: absolute;
            width: 60px;
            height: 60px;
            background: rgba(176, 112, 240, 0.05);
            border-radius: 50%;
            animation: float 8s infinite ease-in-out;
        }

        .bg-shapes div:nth-child(1) { top: 10%; left: 15%; animation-delay: 0s; }
        .bg-shapes div:nth-child(2) { top: 75%; left: 80%; animation-delay: 3s; width: 90px; height: 90px; }
        .bg-shapes div:nth-child(3) { top: 40%; left: 85%; animation-delay: 5s; width: 40px; height: 40px; }

        @keyframes float {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-20px) scale(1.1); }
        }

        .container {
            width: 90%;
            max-width: 440px;
            background: var(--card-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 35px 25px;
            border-radius: 25px;
            box-shadow: 0 15px 35px rgba(21, 11, 36, 0.5);
            text-align: center;
            border: 1px solid rgba(226, 203, 247, 0.15);
            box-sizing: border-box;
        }

        .heart-icon {
            font-size: 35px;
            color: var(--accent-pink);
            margin-bottom: 5px;
            display: inline-block;
            animation: heartbeat 1.5s infinite ease-in-out;
        }

        @keyframes heartbeat {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.18); }
        }

        h1 {
            font-family: 'Sacramento', cursive, sans-serif;
            color: var(--light-purple);
            font-size: 46px;
            margin: 0 0 5px 0;
            font-weight: normal;
        }

        .subtitle {
            font-size: 12px;
            color: var(--accent-pink);
            margin-bottom: 20px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            font-weight: 500;
        }

        /* Music Player Styling */
        .audio-player {
            background: rgba(255, 143, 175, 0.05);
            border: 1px dashed rgba(255, 143, 175, 0.25);
            padding: 12px;
            border-radius: 15px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .audio-info {
            text-align: left;
        }

        .audio-title {
            font-size: 13px;
            font-weight: 500;
            color: var(--light-purple);
            margin: 0;
        }

        .audio-sub {
            font-size: 11px;
            color: var(--text-muted);
            margin: 2px 0 0 0;
        }

        .play-btn {
            background: var(--accent-pink);
            border: none;
            color: #150b24;
            padding: 8px 15px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .play-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 10px rgba(255, 143, 175, 0.4);
        }

        /* Countdown Widget Styling */
        .countdown-title {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--light-purple);
            margin-bottom: 10px;
        }

        .countdown-container {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
            gap: 8px;
        }

        .countdown-box {
            flex: 1;
            background: rgba(176, 112, 240, 0.12);
            border: 1px solid rgba(176, 112, 240, 0.2);
            padding: 10px 5px;
            border-radius: 12px;
        }

        .countdown-num {
            font-size: 20px;
            font-weight: 600;
            color: var(--accent-pink);
            display: block;
        }

        .countdown-label {
            font-size: 10px;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        .message-box {
            background: rgba(176, 112, 240, 0.08);
            border: 1px solid rgba(176, 112, 240, 0.2);
            padding: 22px;
            border-radius: 15px;
            text-align: left;
            margin-bottom: 20px;
        }

        .message-box p {
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.7;
            margin: 0;
        }

        .btn {
            background: linear-gradient(135deg, var(--accent-purple), #9340db);
            color: white;
            border: none;
            padding: 14px 32px;
            font-size: 14px;
            font-weight: 500;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(147, 64, 219, 0.4);
            transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.3s ease;
            width: 100%;
            box-sizing: border-box;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(147, 64, 219, 0.6);
            background: linear-gradient(135deg, #bd85f3, var(--accent-purple));
        }
        
        .btn:active {
            transform: translateY(1px);
        }

        #secret-message {
            margin-top: 25px;
            padding: 18px;
            background: rgba(255, 143, 175, 0.08);
            border-radius: 12px;
            border-left: 4px solid var(--accent-pink);
            font-size: 14px;
            color: var(--light-purple);
            display: none;
            text-align: left;
            line-height: 1.6;
            opacity: 0;
            transform: translateY(10px);
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        #secret-message.show {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>
<body>

    <div class="bg-shapes">
        <div></div>
        <div></div>
        <div></div>
    </div>

    <div class="container">
        <div class="heart-icon">💜</div>
        <h1>Almost 4 Years & Counting</h1>
        <div class="subtitle">Just for my favorite person</div>

        <!-- Music Track Card -->
        <div class="audio-player">
            <div class="audio-info">
                <p class="audio-title">I Wanna Be Yours 🎵</p>
                <p class="audio-sub" id="track-status">Arctic Monkeys</p>
            </div>
            <button class="play-btn" id="playTrigger" onclick="toggleMusic()">PLAY</button>
            <audio id="bgSong" loop src="https://cdns.imp.iim.prod.api.jiosaavn.com/492/e5e4fa49320e8a7194f15bb632126f58_160.mp4"></audio>
        </div>

        <!-- Dynamic Live Countdown Counter -->
        <div class="countdown-title">Days until we see each other ✈️</div>
        <div class="countdown-container" id="timerDisplay">
            <div class="countdown-box"><span class="countdown-num" id="days">00</span><span class="countdown-label">Days</span></div>
            <div class="countdown-box"><span class="countdown-num" id="hours">00</span><span class="countdown-label">Hrs</span></div>
            <div class="countdown-box"><span class="countdown-num" id="minutes">00</span><span class="countdown-label">Min</span></div>
            <div class="countdown-box"><span class="countdown-num" id="seconds">00</span><span class="countdown-label">Sec</span></div>
        </div>
        
        <div class="message-box">
            <p>
                I know distance isn't easy, and sometimes this long-distance journey gets so hard. But after almost four years, I want you to know you're still the only one I want. I miss you so much, and I just want to see you and hold you in person.
            </p>
        </div>

        <button class="btn" onclick="revealMessage()">Click this if you want a kiss too 🥺💋</button>

        <div id="secret-message">
            I miss you beyond words. How much longer are we going to be stuck staring at screens? I am so ready to give you the tightest hug and the sweetest kiss when we finally meet. Please reply soon—you're always my favorite. 💜
        </div>
    </div>

    <script>
        // Music Player Action
        function toggleMusic() {
            var song = document.getElementById("bgSong");
            var btn = document.getElementById("playTrigger");
            var status = document.getElementById("track-status");
            
            if (song.paused) {
                song.play().then(() => {
                    btn.innerText = "PAUSE";
                    status.innerText = "Now playing 🎶";
                }).catch(function(error) {
                    console.log("Playback error:", error);
                });
            } else {
                song.pause();
                btn.innerText = "PLAY";
                status.innerText = "Arctic Monkeys";
            }
        }

        // Reveal Secret Message
        function revealMessage() {
            var secret = document.getElementById("secret-message");
            secret.classList.toggle("show");
        }

        // Countdown Timer
        var targetDate = new Date("Dec 31, 2026 00:00:00").getTime();

        var countdownInterval = setInterval(function() {
            var now = new Date().getTime();
            var distance = targetDate - now;

            if (distance < 0) {
                clearInterval(countdownInterval);
                document.getElementById("timerDisplay").innerHTML = "<p style='color:var(--accent-pink); width:100%; margin:0; font-weight:600;'>We are finally together! 🎉</p>";
                return;
            }

            var days = Math.floor(distance / (1000 * 60 * 60 * 24));
            var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            var seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById("days").innerText = String(days).padStart(2, '0');
            document.getElementById("hours").innerText = String(hours).padStart(2, '0');
            document.getElementById("minutes").innerText = String(minutes).padStart(2, '0');
            document.getElementById("seconds").innerText = String(seconds).padStart(2, '0');
        }, 1000);
    </script>
</body>
</html>
